# Copy to .env. `make setup` fills empty secrets locally. Never commit .env.

# Grok. Leave the key empty to force --offline templates.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# HMAC key for the worker registry. The canary process must not receive this.
WORKER_SECRET=

# Auditor service (127.0.0.1 only). AUDITOR_TOKEN reads the answer key.
# CANARY_INGEST_TOKEN can only POST canary mappings.
AUDITOR_SERVICE_URL=http://127.0.0.1:8765
AUDITOR_TOKEN=
CANARY_INGEST_TOKEN=

# Mattermost. Tokens are personal access tokens (Authorization: Bearer).
MM_BASE_URL=http://127.0.0.1:8065
MM_TOKEN=
MM_CHANNEL_ID=
MM_BOT_USER_ID=
# Mattermost user ids for private canary DMs (POST /api/v4/channels/direct).
MM_USER_AVERY=
MM_USER_BLAKE=
MM_USER_CASEY=

# Switch agent bridge. See docs.switchagents.ai agent protocol.
SWITCH_BASE_URL=
SWITCH_AGENT_ID=
SWITCH_API_TOKEN=
SWITCH_ROOM_ID=
SWITCH_CONNECTION_ID=

# Live web service (`firedrill web`). Empty admin token = runs disabled.
FIREDRILL_ADMIN_TOKEN=
FIREDRILL_DATA_DIR=/tmp/firedrill-live
FIREDRILL_MAX_RUNS_PER_DAY=10
FIREDRILL_RUN_COOLDOWN_SECONDS=60
LLM_MAX_CALLS_PER_RUN=60
LLM_MAX_TOKENS=200
LLM_TIMEOUT_SECONDS=30

# Provider-neutral LLM config (falls back to XAI_*). Example free provider: Groq.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MIN_INTERVAL_SECONDS=0
LLM_MAX_RETRIES=2
LLM_RETRY_AFTER_CAP_SECONDS=20
