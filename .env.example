# Copy to .env. `make setup` fills empty secrets locally. Never commit .env.

# Grok. Leave the key empty to force --offline templates.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# HMAC key for the worker registry. The canary process must not receive this.
WORKER_SECRET=

# Auditor service (127.0.0.1 only). AUDITOR_TOKEN reads the answer key.
# CANARY_INGEST_TOKEN can only POST canary mappings.
AUDITOR_SERVICE_URL=http://127.0.0.1:8765
AUDITOR_TOKEN=
CANARY_INGEST_TOKEN=

# Mattermost. Tokens are personal access tokens (Authorization: Bearer).
MM_BASE_URL=http://127.0.0.1:8065
MM_TOKEN=
MM_CHANNEL_ID=
MM_BOT_USER_ID=
# Mattermost user ids for private canary DMs (POST /api/v4/channels/direct).
MM_USER_AVERY=
MM_USER_BLAKE=
MM_USER_CASEY=

# Switch agent bridge. See docs.switchagents.ai agent protocol.
SWITCH_BASE_URL=
SWITCH_AGENT_ID=
SWITCH_API_TOKEN=
SWITCH_ROOM_ID=
SWITCH_CONNECTION_ID=
